{
  "name": "surface-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The page of a Surface app: the desk, the palette, the agent panel and the modules' views. Sources are in web/ and modules/*/web.",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p packages/chat/tsconfig.json && tsc --noEmit -p packages/cards/tsconfig.json && tsc --noEmit -p packages/genui/tsconfig.json && tsc --noEmit -p packages/theme/tsconfig.json",
    "lint": "biome check web modules packages",
    "test": "node --test packages/*/src/*.test.ts",
    "lint:fix": "biome check --write web modules packages",
    "build:packages": "for p in chat cards genui theme page; do npm run build --prefix packages/$p || exit 1; done",
    "pack-check": "node scripts/pack-check.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hollis-labs/ade-core": "0.1.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "ajv": "8.17.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "flexlayout-react": "0.11.2",
    "lucide-react": "^1.74.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "^4.24.0",
    "remark-gfm": "4.0.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
